annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","DaxQueryView_Desktop","CalcGroup","RemoteModeling"]

ref table dim_product
ref table dim_date
ref table dim_seller
ref table fact_order_items
ref table fact_orders
ref table dim_customer
ref table _Measures
ref table dim_payment_type
ref table bridge_order_payment
ref table 'Time Intelligence'
ref table measure
ref table dimension

