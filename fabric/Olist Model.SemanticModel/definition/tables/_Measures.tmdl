table _Measures
	lineageTag: 8969a2cf-1045-4399-92bd-412be01f9bc8

	measure 'Order Count' = COUNTROWS('fact_orders')
		formatString: #,0
		lineageTag: 840f5be2-d163-48e1-b508-63e56c280b93

	measure 'Orders Delivered' =
			CALCULATE([Order Count],
			    USERELATIONSHIP('fact_orders'[delivered_customer_date], 'dim_date'[date_key]))
		formatString: #,0
		lineageTag: 0b415c05-393c-4b42-95dd-f534612d5bb0

	measure Customers = CALCULATE(DISTINCTCOUNT('dim_customer'[customer_key]), 'fact_orders')
		formatString: #,0
		lineageTag: ef79da20-6e7a-4996-85fe-524a9f329c72

	measure 'Customer Versions' = DISTINCTCOUNT('fact_orders'[customer_sk])
		formatString: #,0
		lineageTag: c667f226-add9-4494-b362-a6dc0ab40e24

	measure 'Avg Days to Deliver' = AVERAGE('fact_orders'[days_to_deliver])
		formatString: #,0.00
		lineageTag: b2e65cd1-fac0-442a-8b62-bbc88fc0638a

	measure 'Avg Days to Deliver (orders containing)' =
			
			CALCULATE([Avg Days to Deliver],
			    CROSSFILTER('fact_order_items'[order_key], 'fact_orders'[order_key], BOTH))
		formatString: #,0.00
		lineageTag: 6d71f089-bc09-41ea-8033-d99ca917d379

	measure 'Orders Containing' = ```
			
			CALCULATE([Order Count],
			    CROSSFILTER('fact_order_items'[order_key], 'fact_orders'[order_key], BOTH))
			
			```
		formatString: #,0
		lineageTag: e6ae2ee6-fe75-4b66-8a35-0929f41eb947

	measure Revenue = SUM('fact_order_items'[price])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d2efcc91-bdcd-4b9e-b989-c3277a7f1188

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Payment Value' = SUM('bridge_order_payment'[payment_value])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b71053b0-6daf-47be-8f74-dab4194e110a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Orders by Payment Type' = ```
			
			CALCULATE([Order Count],
			    CROSSFILTER('bridge_order_payment'[order_key], 'fact_orders'[order_key], BOTH))
			
			```
		formatString: #,0
		lineageTag: c9e7a6fa-d5c3-4522-9c10-13e6f239eba1

	measure 'Revenue by Payment Type' =
			
			CALCULATE([Revenue],
			    CROSSFILTER('bridge_order_payment'[order_key], 'fact_orders'[order_key], BOTH))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 4f040ec2-0f54-44b6-a7a4-756598a1ba0f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Review via Bridge' =
			
			AVERAGEX('bridge_order_payment', RELATED('fact_orders'[review_score]))
		lineageTag: a450a1ae-e91d-4f63-9c95-4e3b6e66d630

	column Value
		formatString: 0
		lineageTag: 04abdde2-b4bb-4760-ac6a-c71d7f0f0904
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = {BLANK()}

	annotation PBI_Id = 1310a5eddfb740f7b0ef27ef15bc9ee3

