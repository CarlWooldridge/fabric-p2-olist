table _Measures
	lineageTag: 8969a2cf-1045-4399-92bd-412be01f9bc8

	measure 'Order Count' = ```
			COUNTROWS('fact_orders') -- header
			
			```
		formatString: #,0
		lineageTag: 840f5be2-d163-48e1-b508-63e56c280b93

	measure 'Orders Delivered' =
			CALCULATE([Order Count],
			    USERELATIONSHIP('fact_orders'[delivered_customer_date], 'dim_date'[date_key]))
		formatString: #,0
		lineageTag: 0b415c05-393c-4b42-95dd-f534612d5bb0

	measure Customers = CALCULATE(DISTINCTCOUNT('dim_customer'[customer_key]), 'fact_orders')
		formatString: #,0
		lineageTag: ef79da20-6e7a-4996-85fe-524a9f329c72

	measure 'Customer Versions' = DISTINCTCOUNT('fact_orders'[customer_sk])
		formatString: #,0
		lineageTag: c667f226-add9-4494-b362-a6dc0ab40e24

	measure 'Avg Days to Deliver' = AVERAGE('fact_orders'[days_to_deliver])
		formatString: #,0.00
		lineageTag: b2e65cd1-fac0-442a-8b62-bbc88fc0638a

	measure 'Avg Days to Deliver (orders containing)' =
			
			CALCULATE([Avg Days to Deliver],
			    CROSSFILTER('fact_order_items'[order_key], 'fact_orders'[order_key], BOTH))
		formatString: #,0.00
		lineageTag: 6d71f089-bc09-41ea-8033-d99ca917d379

	measure 'Orders Containing' = ```
			
			CALCULATE([Order Count],
			    CROSSFILTER('fact_order_items'[order_key], 'fact_orders'[order_key], BOTH))
			
			```
		formatString: #,0
		lineageTag: e6ae2ee6-fe75-4b66-8a35-0929f41eb947

	measure Revenue = SUM('fact_order_items'[price]) --lines
		displayFolder: Revenue
		lineageTag: d2efcc91-bdcd-4b9e-b989-c3277a7f1188

		formatStringDefinition =
				SWITCH(TRUE(),
				    SELECTEDMEASURE() < 1000,    "#,##0",
				    SELECTEDMEASURE() < 1000000, "#,##0,.0\K",
				                                 "#,##0,,.0\M")

	measure 'Payment Value' = SUM('bridge_order_payment'[payment_value])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b71053b0-6daf-47be-8f74-dab4194e110a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Orders by Payment Type' = ```
			
			CALCULATE([Order Count],
			    CROSSFILTER('bridge_order_payment'[order_key], 'fact_orders'[order_key], BOTH))
			
			```
		formatString: #,0
		lineageTag: c9e7a6fa-d5c3-4522-9c10-13e6f239eba1

	measure 'Revenue by Payment Type' =
			
			CALCULATE([Revenue],
			    CROSSFILTER('bridge_order_payment'[order_key], 'fact_orders'[order_key], BOTH))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Revenue
		lineageTag: 4f040ec2-0f54-44b6-a7a4-756598a1ba0f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Review via Bridge' =
			
			AVERAGEX('bridge_order_payment', RELATED('fact_orders'[review_score]))
		lineageTag: a450a1ae-e91d-4f63-9c95-4e3b6e66d630

	measure Freight = SUM('fact_order_items'[freight_value])  -- lines
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 777a79ef-9d8c-4034-a51f-16f8a7043620

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue YTD' = CALCULATE([Revenue], DATESYTD('dim_date'[date_key]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Revenue
		lineageTag: 4f7af7c5-e9f5-4cb8-a889-14a75d812861

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue PY' = CALCULATE([Revenue], SAMEPERIODLASTYEAR('dim_date'[date_key]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Revenue
		lineageTag: abeab950-f6ef-4dfb-8e9b-a06905dea682

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue YoY %' =
			
			VAR cur = [Revenue]
			VAR py  = [Revenue PY]
			RETURN DIVIDE(cur - py, py)
		displayFolder: Revenue
		lineageTag: b1d3703d-7bf8-4782-9bea-32f852a461de

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Freight YTD' = CALCULATE([Freight], DATESYTD('dim_date'[date_key]))
		formatString: 0
		lineageTag: c08ba6a8-2ef7-4b0d-a842-947f1a7a536a

	measure 'Freight YoY %' =
			
			VAR cur = [Freight]
			VAR py  = [Freight PY]
			RETURN DIVIDE(cur - py, py)
		lineageTag: e7f0c5c6-b817-4e72-93ca-6b85e2a0b8ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Count YTD' = CALCULATE([Order Count], DATESYTD('dim_date'[date_key]))
		formatString: 0
		lineageTag: f4caaf38-0b39-412b-bfcc-03de94790513

	measure 'Order Count PY' = CALCULATE([Order Count], SAMEPERIODLASTYEAR('dim_date'[date_key]))
		formatString: 0
		lineageTag: 6cd28977-df07-4c46-b884-19256c9708d6

	measure 'Order Count YoY %' =
			
			VAR cur = [Order Count]
			VAR py  = [Order Count PY]
			RETURN DIVIDE(cur - py, py)
		formatString: 0
		lineageTag: 38e150b4-1576-492d-8684-84e8d600f6f8

	measure 'Freight PY' = CALCULATE([Freight], SAMEPERIODLASTYEAR('dim_date'[date_key]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 790eee2b-14e3-4709-92d0-1180e9ca7ebf

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue Rank' =
			
			RANK(DENSE, ALLSELECTED('dim_seller'[seller_state]), ORDERBY([Revenue], DESC))
		displayFolder: Revenue
		lineageTag: f2888fb7-9b40-4773-ae0e-1c7510019e9c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue vs Prev Month' =
			
			VAR prev = CALCULATE([Revenue], OFFSET(-1, , ORDERBY('dim_date'[month_key], ASC)))
			RETURN [Revenue] - prev
		displayFolder: Revenue
		lineageTag: 5d0bead2-a21e-4c8f-ae1a-1c420ab5016a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue 3mo Moving Avg' =
			
			AVERAGEX(
			    WINDOW(-2, REL, 0, REL, ALLSELECTED('dim_date'[month_key]),
			           ORDERBY('dim_date'[month_key], ASC)),
			    [Revenue])
		displayFolder: Revenue
		lineageTag: 9708a1a8-d924-4d91-a0af-4dc8bb20828f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'First Month Revenue' =
			
			CALCULATE([Revenue], INDEX(1, FILTER(ALLSELECTED('dim_date'[month_key]), [Revenue] > 0),
			          ORDERBY('dim_date'[month_key], ASC)))
		displayFolder: Revenue
		lineageTag: 97077985-4d66-4320-a469-13b3ab96657f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Value
		formatString: 0
		lineageTag: 04abdde2-b4bb-4760-ac6a-c71d7f0f0904
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = {BLANK()}

	annotation PBI_Id = 1310a5eddfb740f7b0ef27ef15bc9ee3

